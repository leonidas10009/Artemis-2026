<?xml version="1.0" encoding="utf-8"?>
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:columnWidth="@dimen/artemis_pc_card_width"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:horizontalSpacing="@dimen/artemis_grid_spacing"
    android:numColumns="auto_fit"
    android:padding="@dimen/artemis_grid_padding"
    android:paddingBottom="@dimen/artemis_grid_bottom_padding"
    android:stretchMode="spacingWidthUniform"
    android:verticalSpacing="@dimen/artemis_grid_spacing" />
