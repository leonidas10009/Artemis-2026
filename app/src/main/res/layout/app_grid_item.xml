<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Artemis.Card"
    android:layout_width="@dimen/artemis_app_card_width"
    android:layout_height="@dimen/artemis_app_card_height"
    android:layout_margin="@dimen/artemis_grid_spacing">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:cropToPadding="false"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/grid_scrim"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_scrim" />

        <RelativeLayout
            android:id="@+id/grid_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/grid_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="@dimen/artemis_spacing_md"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/artemis_text"
                android:textSize="@dimen/artemis_app_title_size"
                android:textStyle="bold" />

        </RelativeLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
