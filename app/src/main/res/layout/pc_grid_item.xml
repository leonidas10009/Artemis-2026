<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Artemis.Card"
    android:layout_width="@dimen/artemis_pc_card_width"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/artemis_spacing_xs"
    android:minHeight="176dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/artemis_spacing_md">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerInside" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/artemis_primary"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/artemis_spacing_sm"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Artemis.Body"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/artemis_spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/grid_status_dot"
                android:layout_width="@dimen/artemis_status_dot"
                android:layout_height="@dimen/artemis_status_dot"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/grid_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="@style/TextAppearance.Artemis.Caption"
                android:textColor="@color/artemis_text_muted" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
