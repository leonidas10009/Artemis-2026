<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Artemis.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/artemis_grid_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/artemis_spacing_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/artemis_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/artemis_spacing_xs"
                android:textColor="@color/artemis_text_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <RadioButton
            android:id="@+id/profileActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/artemis_spacing_sm"
            android:layout_marginEnd="@dimen/artemis_spacing_sm"
            android:contentDescription="@string/profile_manager_choose_profile" />

        <ImageButton
            android:id="@+id/editProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_manager_edit_profile"
            android:src="@drawable/ic_edit"
            android:tint="@color/artemis_text" />

        <ImageButton
            android:id="@+id/deleteProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_manager_delete_profile"
            android:src="@drawable/ic_delete"
            android:tint="@color/artemis_danger" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
